# --- Обязательное -----------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...
# Ключ OpenAI: нужен всегда — распознавание и синтез речи идут через OpenAI Audio API
OPENAI_API_KEY=sk-...

# --- Какой LLM переводит ----------------------------------------------------
# openai (по умолчанию) или anthropic
LLM_PROVIDER=openai
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# Нужны, только если LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — для перевода реплики достаточно low
ANTHROPIC_EFFORT=low

# --- Речь -------------------------------------------------------------------
# whisper-1 (дёшево и стабильно) или gpt-4o-transcribe / gpt-4o-mini-transcribe
STT_MODEL=whisper-1
# Порог «я не расслышал». Голосовое расшифровывается дважды — как сербское и как
# русское, — и побеждает вариант с большей уверенностью. Если даже победитель ниже
# STT_MIN_LOGPROB или сегменты выглядят как тишина выше STT_MAX_NO_SPEECH, бот
# просит перезаписать вместо того, чтобы переводить выдумку. Работает с whisper-1:
# у gpt-4o-transcribe нет посегментных метрик, там остаётся один проход.
STT_MIN_LOGPROB=-0.7
STT_MAX_NO_SPEECH=0.4
# gpt-4o-mini-tts (поддерживает инструкции по стилю) или tts-1 / tts-1-hd
TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
TTS_VOICE=alloy
# Работает только с tts-1/tts-1-hd, диапазон 0.25–4.0
TTS_SPEED=1.0

# --- Поведение --------------------------------------------------------------
# latin (latinica) или cyrillic (ćirilica)
SERBIAN_SCRIPT=latin
# Присылать текст перевода вместе с голосовым
SEND_TRANSLATION_TEXT=true
# Максимальная длина голосового, сек
MAX_VOICE_DURATION=180
# Максимальная длина текстового сообщения, символов
MAX_TEXT_LENGTH=1500
# Таймаут одного вызова API, сек
REQUEST_TIMEOUT=90
# Белый список Telegram user id через запятую; пусто = бот открыт всем
ALLOWED_USER_IDS=
LOG_LEVEL=INFO
